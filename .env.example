# Docker Compose reads .env next to docker-compose.yml. Copy this file to .env.
# Choose a stable hostname before creating inboxes. No scheme, port or path.
RELAY_HOST=localhost

# Publish on loopback by default. Change only to an interface clients should reach.
BIND_IP=127.0.0.1
RELAY_PORT=2222

# Place approved PUBLIC keys in this directory's authorized_keys file.
SSH_CONFIG_DIR=./ssh-config
